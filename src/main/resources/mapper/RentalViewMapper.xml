<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.veryai.arcreactor.mapper.RentalViewMapper">
    <resultMap id="dueEntry" type="cn.veryai.arcreactor.entity.LeaseDueEntry">
        <constructor>
            <arg column="lease_id" javaType="java.lang.String" jdbcType="VARCHAR"/>
            <arg column="next_action_at" javaType="java.time.Instant" jdbcType="TIMESTAMP"
                 typeHandler="org.apache.ibatis.type.InstantTypeHandler"/>
        </constructor>
    </resultMap>

    <resultMap id="leaseView" type="cn.veryai.arcreactor.entity.LeaseViewEntity">
        <id property="leaseId" column="lease_id" jdbcType="VARCHAR"/>
        <result property="userId" column="user_id" jdbcType="VARCHAR"/>
        <result property="phase" column="phase" jdbcType="VARCHAR"
                javaType="cn.veryai.arcreactor.actor.lease.model.LeaseState$Phase"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="periodSeq" column="period_seq" jdbcType="BIGINT"/>
        <result property="currentOrderId" column="current_order_id" jdbcType="VARCHAR"/>
        <result property="currentPlanUnit" column="current_plan_unit" jdbcType="VARCHAR"
                javaType="cn.veryai.arcreactor.actor.lease.model.RentalPlan$Unit"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="currentPlanQuantity" column="current_plan_quantity" jdbcType="INTEGER"/>
        <result property="currentAmount" column="current_amount" jdbcType="DECIMAL"/>
        <result property="currentStartsAt" column="current_starts_at" javaType="java.time.Instant" jdbcType="TIMESTAMP"
                typeHandler="org.apache.ibatis.type.InstantTypeHandler"/>
        <result property="currentEndsAt" column="current_ends_at" javaType="java.time.Instant" jdbcType="TIMESTAMP"
                typeHandler="org.apache.ibatis.type.InstantTypeHandler"/>
        <result property="lastPeriodEndsAt" column="last_period_ends_at" javaType="java.time.Instant" jdbcType="TIMESTAMP"
                typeHandler="org.apache.ibatis.type.InstantTypeHandler"/>
        <result property="renewalPlanUnit" column="renewal_plan_unit" jdbcType="VARCHAR"
                javaType="cn.veryai.arcreactor.actor.lease.model.RentalPlan$Unit"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="renewalPlanQuantity" column="renewal_plan_quantity" jdbcType="INTEGER"/>
        <result property="planRevision" column="plan_revision" jdbcType="BIGINT"/>
        <result property="autoRenew" column="auto_renew" jdbcType="BOOLEAN"/>
        <result property="pendingOrderId" column="pending_order_id" jdbcType="VARCHAR"/>
        <result property="pendingPeriodSeq" column="pending_period_seq" jdbcType="BIGINT"/>
        <result property="pendingPlanUnit" column="pending_plan_unit" jdbcType="VARCHAR"
                javaType="cn.veryai.arcreactor.actor.lease.model.RentalPlan$Unit"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="pendingPlanQuantity" column="pending_plan_quantity" jdbcType="INTEGER"/>
        <result property="pendingAmount" column="pending_amount" jdbcType="DECIMAL"/>
        <result property="pendingPlanRevision" column="pending_plan_revision" jdbcType="BIGINT"/>
        <result property="pendingPhase" column="pending_phase" jdbcType="VARCHAR"
                javaType="cn.veryai.arcreactor.actor.lease.model.LeaseState$PurchasePhase"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="settlementOrderId" column="settlement_order_id" jdbcType="VARCHAR"/>
        <result property="settlementAmount" column="settlement_amount" jdbcType="DECIMAL"/>
        <result property="settlementDeductAmount" column="settlement_deduct_amount" jdbcType="DECIMAL"/>
        <result property="terminatedAt" column="terminated_at" javaType="java.time.Instant" jdbcType="TIMESTAMP"
                typeHandler="org.apache.ibatis.type.InstantTypeHandler"/>
        <result property="nextActionAt" column="next_action_at" javaType="java.time.Instant" jdbcType="TIMESTAMP"
                typeHandler="org.apache.ibatis.type.InstantTypeHandler"/>
        <result property="error" column="error" jdbcType="LONGVARCHAR"/>
    </resultMap>

    <sql id="leaseColumns">
        lease_id, user_id, phase, period_seq,
        current_order_id, current_plan_unit, current_plan_quantity, current_amount,
        current_starts_at, current_ends_at, last_period_ends_at,
        renewal_plan_unit, renewal_plan_quantity, plan_revision, auto_renew,
        pending_order_id, pending_period_seq, pending_plan_unit,
        pending_plan_quantity, pending_amount, pending_plan_revision, pending_phase,
        settlement_order_id, settlement_amount, settlement_deduct_amount,
        terminated_at, next_action_at, error
    </sql>

    <select id="findDueLeases" resultMap="dueEntry">
        SELECT lease_id, next_action_at
        FROM lease_view
        WHERE next_action_at &lt;= #{cutoff,javaType=java.time.Instant,jdbcType=TIMESTAMP,typeHandler=org.apache.ibatis.type.InstantTypeHandler}
        <if test="after != null">
            AND (next_action_at, lease_id) &gt;
                (#{after.nextActionAt,javaType=java.time.Instant,jdbcType=TIMESTAMP,typeHandler=org.apache.ibatis.type.InstantTypeHandler},
                 #{after.leaseId,jdbcType=VARCHAR})
        </if>
        ORDER BY next_action_at, lease_id
        LIMIT #{limit,jdbcType=INTEGER}
    </select>

    <select id="findLeasesByUser" resultMap="leaseView">
        SELECT <include refid="leaseColumns"/> FROM lease_view
        WHERE user_id = #{userId,jdbcType=VARCHAR}
        ORDER BY updated_at DESC, lease_id
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.veryai.arcreactor.mapper.InstanceViewMapper">
    <resultMap id="entity" type="cn.veryai.arcreactor.entity.InstanceViewEntity">
        <id column="instance_id" property="instanceId"/>
        <result column="request_id" property="requestId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="user_id" property="userId"/>
        <result column="cluster_id" property="clusterId"/>
        <result column="region_id" property="regionId"/>
        <result column="os_project_id" property="osProjectId"/>
        <result column="os_image_id" property="osImageId"/>
        <result column="os_flavor_id" property="osFlavorId"/>
        <result column="hypervisor_type" property="hypervisorType"/>
        <result column="vcpus" property="vcpus"/>
        <result column="memory_gb" property="memoryGb"/>
        <result column="disk_gb" property="diskGb"/>
        <result column="gpu_count" property="gpuCount"/>
        <result column="share_id" property="shareId"/>
        <result column="os_parent_network_id" property="osParentNetworkId"/>
        <result column="os_parent_subnet_id" property="osParentSubnetId"/>
        <result column="os_sub_network_id" property="osSubNetworkId"/>
        <result column="os_sub_subnet_id" property="osSubSubnetId"/>
        <result column="os_sub_floating_network_id" property="osSubFloatingNetworkId"/>
        <result column="segmentation_id" property="segmentationId"/>
        <result column="phase" property="phase"/>
        <result column="hypervisor_id" property="hypervisorId"/>
        <result column="hostname" property="hostname"/>
        <result column="reservation_id" property="reservationId"/>
        <result column="os_nova_server_id" property="osNovaServerId"/>
        <result column="nova_status" property="novaStatus"/>
        <result column="os_security_group_id" property="osSecurityGroupId"/>
        <result column="os_parent_port_id" property="osParentPortId"/>
        <result column="parent_mac_address" property="parentMacAddress"/>
        <result column="parent_fixed_ip" property="parentFixedIp"/>
        <result column="os_parent_qos_policy_id" property="osParentQosPolicyId"/>
        <result column="os_parent_qos_ingress_rule_id" property="osParentQosIngressRuleId"/>
        <result column="os_parent_qos_egress_rule_id" property="osParentQosEgressRuleId"/>
        <result column="parent_max_kbps" property="parentMaxKbps"/>
        <result column="parent_max_burst_kbits" property="parentMaxBurstKbits"/>
        <result column="os_sub_port_id" property="osSubPortId"/>
        <result column="sub_fixed_ip" property="subFixedIp"/>
        <result column="os_sub_qos_policy_id" property="osSubQosPolicyId"/>
        <result column="os_sub_qos_ingress_rule_id" property="osSubQosIngressRuleId"/>
        <result column="os_sub_qos_egress_rule_id" property="osSubQosEgressRuleId"/>
        <result column="sub_max_kbps" property="subMaxKbps"/>
        <result column="sub_max_burst_kbits" property="subMaxBurstKbits"/>
        <result column="os_sub_floating_ip_id" property="osSubFloatingIpId"/>
        <result column="sub_floating_ip_address" property="subFloatingIpAddress"/>
        <result column="os_trunk_id" property="osTrunkId"/>
        <result column="server_operation" property="serverOperation" typeHandler="cn.veryai.arcreactor.mapper.typehandler.InstanceServerOperationJsonTypeHandler"/>
        <result column="failure_code" property="failureCode"/>
        <result column="failure_message" property="failureMessage"/>
        <result column="failed_at" property="failedAt"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="workflow_version" property="workflowVersion"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="columns">
        instance_id, request_id, name, description,
        user_id, cluster_id, region_id, os_project_id,
        os_image_id, os_flavor_id, hypervisor_type, vcpus,
        memory_gb, disk_gb, gpu_count, share_id,
        os_parent_network_id, os_parent_subnet_id, os_sub_network_id, os_sub_subnet_id,
        os_sub_floating_network_id, segmentation_id, phase, hypervisor_id, hostname,
        reservation_id, os_nova_server_id, nova_status,
        os_security_group_id, os_parent_port_id, parent_mac_address, parent_fixed_ip,
        os_parent_qos_policy_id, os_parent_qos_ingress_rule_id, os_parent_qos_egress_rule_id, parent_max_kbps,
        parent_max_burst_kbits, os_sub_port_id, sub_fixed_ip, os_sub_qos_policy_id,
        os_sub_qos_ingress_rule_id, os_sub_qos_egress_rule_id, sub_max_kbps, sub_max_burst_kbits,
        os_sub_floating_ip_id, sub_floating_ip_address, os_trunk_id,
        server_operation, failure_code, failure_message, failed_at, deleted_at, workflow_version,
        created_at, updated_at
    </sql>

    <select id="findByUser" resultMap="entity">
        SELECT <include refid="columns"/>
        FROM instance_view
        WHERE user_id = #{userId}
        <if test="regionId != null">
          AND region_id = #{regionId}
        </if>
        <if test="phase != null">
          AND phase = #{phase}
        </if>
        ORDER BY created_at DESC, instance_id ASC
    </select>

    <select id="findByUserAndId" resultMap="entity">
        SELECT <include refid="columns"/>
        FROM instance_view
        WHERE user_id = #{userId} AND instance_id = #{instanceId}
    </select>
</mapper>

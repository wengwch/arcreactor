<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.veryai.arcreactor.actor.order.projection.mybatis.OrderProjectionMapper">
    <sql id="projectionMetadata">
        workflow_version = #{version,jdbcType=BIGINT},
        updated_at = #{updatedAt,jdbcType=TIMESTAMP}
    </sql>

    <sql id="previousVersion">
        WHERE order_id = #{orderId,jdbcType=VARCHAR}
          AND workflow_version = #{version,jdbcType=BIGINT} - 1
    </sql>

    <select id="findVersionForUpdate" resultType="java.lang.Long" useCache="false">
        SELECT workflow_version FROM order_view
        WHERE order_id = #{orderId,jdbcType=VARCHAR}
        FOR UPDATE
    </select>

    <insert id="insertCreated">
        INSERT INTO order_view
          (order_id, user_id, lease_id, amount, phase, deduct_amount, error, workflow_version, updated_at)
        VALUES
          (#{orderId,jdbcType=VARCHAR}, #{userId,jdbcType=VARCHAR}, #{leaseId,jdbcType=VARCHAR},
           #{amount,jdbcType=DECIMAL}, 'LOCKING', NULL, NULL,
           #{version,jdbcType=BIGINT}, #{updatedAt,jdbcType=TIMESTAMP})
    </insert>

    <update id="updateLocked">
        UPDATE order_view
        SET phase = 'LOCKED',
            error = NULL,
            <include refid="projectionMetadata"/>
        <include refid="previousVersion"/>
    </update>

    <update id="updateDeductionRequested">
        UPDATE order_view
        SET phase = 'DEDUCTING',
            deduct_amount = #{deductAmount,jdbcType=DECIMAL},
            error = NULL,
            <include refid="projectionMetadata"/>
        <include refid="previousVersion"/>
    </update>

    <update id="updateDeducted">
        UPDATE order_view
        SET phase = 'SETTLED',
            error = NULL,
            <include refid="projectionMetadata"/>
        <include refid="previousVersion"/>
    </update>

    <update id="updateInsufficientFunds">
        UPDATE order_view
        SET phase = 'INSUFFICIENT_FUNDS',
            error = 'INSUFFICIENT_FUNDS',
            <include refid="projectionMetadata"/>
        <include refid="previousVersion"/>
    </update>

    <update id="updateError">
        UPDATE order_view
        SET error = #{error,jdbcType=LONGVARCHAR},
            <include refid="projectionMetadata"/>
        <include refid="previousVersion"/>
    </update>
</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.veryai.arcreactor.mapper.OpenstackClusterMapper">
    <resultMap id="cluster" type="cn.veryai.arcreactor.entity.OpenstackClusterEntity">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="admin_username" property="adminUsername"/>
        <result column="admin_password" property="adminPassword"/>
        <result column="os_admin_default_project_id" property="osAdminDefaultProjectId"/>
        <result column="os_admin_default_domain_id" property="osAdminDefaultDomainId"/>
        <result column="os_admin_default_region" property="osAdminDefaultRegion"/>
        <result column="auth_endpoint" property="authEndpoint"/>
        <result column="os_member_role_id" property="osMemberRoleId"/>
        <result column="os_admin_role_id" property="osAdminRoleId"/>
    </resultMap>

    <sql id="columns">id, name, description, admin_username, admin_password, os_admin_default_project_id, os_admin_default_domain_id, os_admin_default_region, auth_endpoint, os_member_role_id, os_admin_role_id</sql>

    <insert id="insert">
        INSERT INTO openstack_cluster (<include refid="columns"/>)
        VALUES (#{id}, #{name}, #{description}, #{adminUsername}, #{adminPassword}, #{osAdminDefaultProjectId}, #{osAdminDefaultDomainId}, #{osAdminDefaultRegion}, #{authEndpoint}, #{osMemberRoleId}, #{osAdminRoleId})
    </insert>

    <select id="findById" resultMap="cluster">
        SELECT <include refid="columns"/> FROM openstack_cluster WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="cluster">
        SELECT <include refid="columns"/> FROM openstack_cluster ORDER BY name, id
    </select>

    <update id="update">
        UPDATE openstack_cluster SET
            name = #{name},
            description = #{description},
            admin_username = #{adminUsername},
            admin_password = #{adminPassword},
            os_admin_default_project_id = #{osAdminDefaultProjectId},
            os_admin_default_domain_id = #{osAdminDefaultDomainId},
            os_admin_default_region = #{osAdminDefaultRegion},
            auth_endpoint = #{authEndpoint},
            os_member_role_id = #{osMemberRoleId},
            os_admin_role_id = #{osAdminRoleId}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM openstack_cluster WHERE id = #{id}
    </delete>
</mapper>
